# Local development only. Copy this file to .env and replace values locally.
# Never commit .env or send its contents in chat.

NODE_ENV=development
PORT=3000
# Persistent local state for duplicate-delivery prevention. In production this
# path must be on a mounted persistent volume, never an ephemeral filesystem.
SLACKFLOW_STATE_PATH=.slackflow/state.sqlite

# Slackflow Dev Slack app
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Model provider. The app calls providers through a provider-neutral interface.
# Only the OpenAI adapter is implemented in this milestone.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna
LLM_REASONING_EFFORT=medium
OPENAI_API_KEY=
# Reserved for the future native Anthropic adapter; do not set it yet.
ANTHROPIC_API_KEY=

# Image provider. This adapter is separate from the text model adapter. A ready
# @slackflow draft run generates a thumbnail and banner for Slack review. Neither
# is written to Webflow until an explicit Create Webflow draft confirmation.
IMAGE_PROVIDER=openai
IMAGE_MODEL=gpt-image-2
# GPT Image 2 returns this source landscape size. Slackflow derives a 1920x1080
# thumbnail and 1920x640 banner from the reviewed source image.
IMAGE_BLOG_SIZE=1536x1024
IMAGE_QUALITY=medium
IMAGE_OUTPUT_FORMAT=jpeg

WEBFLOW_MCP_URL=https://mcp.webflow.com/mcp
# Required only for @slackflow connect. Use the public Render origin with no
# trailing path. The token key must be a base64-encoded 32-byte random value.
PUBLIC_BASE_URL=
WEBFLOW_TOKEN_ENCRYPTION_KEY=
